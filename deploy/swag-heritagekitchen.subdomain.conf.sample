# SWAG proxy configuration for Heritage Kitchen. Copy to
# /config/nginx/proxy-confs/heritagekitchen.subdomain.conf inside the SWAG appdata
# folder, adjust server_name and restart SWAG. The app container must be named
# heritagekitchen and share a Docker network with SWAG.
server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name kitchen.*;

    include /config/nginx/ssl.conf;

    # Recipe image uploads are limited to 20 MB by the app.
    client_max_body_size 21m;

    location / {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app heritagekitchen;
        set $upstream_port 8000;
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }
}
