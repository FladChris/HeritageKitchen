# Copy to deploy/.env to override Compose defaults.
HERITAGEKITCHEN_TAG=latest
APP_BIND_IP=127.0.0.1
HTTP_PORT=8081
# Use the trusted proxy address as seen by the app when terminating TLS upstream.
FORWARDED_ALLOW_IPS=127.0.0.1
SESSION_COOKIE_SECURE=auto
# Optional PostgreSQL connection URL.
# DATABASE_URL=postgresql+psycopg://heritagekitchen:REPLACE_ME@db.example.com:5432/heritagekitchen
# Optional canonical URL for email confirmation and password reset links.
# RESET_BASE_URL=https://cookbook.example.com
# Set a generated Fernet key when using an SMTP password.
MAIL_CREDENTIALS_KEY=
