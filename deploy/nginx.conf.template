# Host nginx example. Replace ${DOMAIN} and
# ${HTTPS_PORT} manually (or with envsubst restricted to these two variables).
server {
    listen ${HTTPS_PORT} ssl;
    server_name ${DOMAIN};
    client_max_body_size 21m;
    ssl_certificate /etc/heritagekitchen/certs/fullchain.pem;
    ssl_certificate_key /etc/heritagekitchen/certs/key.pem;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
