# syntax=docker/dockerfile:1
FROM node:24.15.0-alpine AS frontend
WORKDIR /app/site
COPY site/.npmrc site/package.json site/package-lock.json ./
RUN npm ci
COPY site ./
RUN npm run build

FROM python:3.14-slim
ARG APP_VERSION=dev
LABEL org.opencontainers.image.version="${APP_VERSION}"
ENV APP_VERSION=${APP_VERSION} \
    SQLITE_DATABASE_PATH=/data/heritagekitchen.db \
    SPA_DIR=/app/site/build \
    FORWARDED_ALLOW_IPS=127.0.0.1
RUN pip install --no-cache-dir uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --extra postgres
COPY app ./app
COPY main.py ./main.py
COPY alembic.ini ./alembic.ini
COPY migrations ./migrations
COPY --from=frontend /app/site/build ./site/build
EXPOSE 8000
# With UVICORN_SSL_CERTFILE set the app serves HTTPS itself; the certificate is
# issued for the public host name, so the loopback check does not verify it.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["/app/.venv/bin/python", "-c", "import os, ssl, urllib.request; tls = bool(os.environ.get('UVICORN_SSL_CERTFILE')); urllib.request.urlopen(('https' if tls else 'http') + '://127.0.0.1:8000/health', timeout=3, context=ssl._create_unverified_context() if tls else None)"]
# Uvicorn reads FORWARDED_ALLOW_IPS; only the trusted reverse proxy may supply headers.
CMD ["/app/.venv/bin/uvicorn", "app.api:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
